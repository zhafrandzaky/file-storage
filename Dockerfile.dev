# Development image: Go toolchain + air for hot reload.
# Source code is bind-mounted from the host at /src (see compose.dev.yml).
FROM golang:1.25-alpine
RUN apk add --no-cache gcc musl-dev git \
    && go install github.com/air-verse/air@v1.61.7
WORKDIR /src
ENV CGO_ENABLED=1
EXPOSE 8000
CMD ["air", "-c", ".air.toml"]
