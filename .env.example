# Copy to .env and change every secret before running:
#   cp .env.example .env

# --- First administrator (created on first start if the email is new) ---
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# --- RustFS root credentials, also used by the app to sign S3 requests ---
RUSTFS_ACCESS_KEY=change-me-access-key
RUSTFS_SECRET_KEY=change-me-secret-key

# Bucket for stored files (created automatically on start)
S3_BUCKET=file-storage
S3_REGION=us-east-1

# Address browsers use to reach RustFS. Required for share links, because a
# presigned URL must point at a host the recipient can open. Leave empty to
# disable sharing. Example for a VM: http://192.168.122.100:9000
S3_PUBLIC_ENDPOINT=

# --- Production ports (docker-compose.yml) ---
APP_PORT=8000
S3_API_PORT=9000
S3_CONSOLE_PORT=9001

# --- Development stack (compose.dev.yml), separate data and ports ---
DEV_APP_PORT=8100
DEV_WEB_PORT=5173
DEV_S3_API_PORT=9100
DEV_S3_CONSOLE_PORT=9101
# Share links in development point at the dev RustFS, e.g. http://192.168.122.100:9100
DEV_S3_PUBLIC_ENDPOINT=

# --- Upload policy ---
MAX_FILE_MB=25
MAX_UPLOAD_MB=64
# Comma-separated extensions. Empty uses the built-in list (documents,
# images, spreadsheets and archives).
ALLOWED_EXTENSIONS=

# --- Sessions and sharing ---
SESSION_TTL_HOURS=12
SHARE_MAX_HOURS=168
# Set to true when the app is served over HTTPS
COOKIE_SECURE=false

# --- Images. Pin a version (for example rustfs/rustfs:1.0.0) beyond a lab ---
RUSTFS_IMAGE=rustfs/rustfs:latest
APP_IMAGE=file-storage:latest
