# Copy to .env and change the secrets before running:
#   cp .env.example .env

# Ports published on the host
APP_PORT=8000
S3_API_PORT=9000
S3_CONSOLE_PORT=9001

# RustFS root credentials, also used by the app to sign S3 requests.
# Use your own values; the secret should be at least 8 characters.
RUSTFS_ACCESS_KEY=change-me-access-key
RUSTFS_SECRET_KEY=change-me-secret-key

# Bucket the app stores documents in (created automatically on start)
S3_BUCKET=file-storage
S3_REGION=us-east-1

# Maximum total size of one upload request, in megabytes
MAX_UPLOAD_MB=64

# Images. Pin a version (for example rustfs/rustfs:1.0.0) for anything beyond a lab.
RUSTFS_IMAGE=rustfs/rustfs:latest
APP_IMAGE=file-storage:latest
